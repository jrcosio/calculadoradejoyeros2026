<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de copia de seguridad (dispositivos hasta API 30; desde API 31 mandan las de
    data_extraction_rules.xml). La caché de cotizaciones (feature 007) se excluye: es un dato
    derivado con fecha; restaurarla en otro dispositivo o con otra hora solo provocaría una
    recarga y no aporta nada al joyero.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="cotizaciones.xml" />
    <!--
        El idioma elegido (feature 008, files/datastore/ajustes.preferences_pb) NO se excluye a
        propósito: es una decisión del joyero y debe acompañarle al móvil nuevo (FR-025).
    -->
    <!--
        Los favoritos (feature 009, databases/favoritos.db) tampoco se excluyen: son cálculos que el
        joyero ha decidido conservar y deben viajar con él (FR-033). El journal va en TRUNCATE
        justamente por esto: sin ficheros -wal/-shm, no hay forma de restaurar la base a medias.
    -->
</full-backup-content>
