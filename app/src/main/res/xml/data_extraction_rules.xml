<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de extracción de datos (API 31+). La caché de cotizaciones (feature 007) queda fuera
    tanto de la copia en la nube como de la transferencia entre dispositivos: es un dato
    derivado con fecha que la app vuelve a pedir al proveedor cuando caduca.
-->
<data-extraction-rules>
    <!--
        El idioma elegido (feature 008, files/datastore/ajustes.preferences_pb) no aparece en
        ninguna exclusión a propósito: entra en la copia y en la transferencia, porque es una
        decisión del joyero y debe acompañarle al móvil nuevo (FR-025).

        Lo mismo con los favoritos (feature 009, databases/favoritos.db): son cálculos que el joyero
        ha decidido conservar (FR-033), y el journal en TRUNCATE garantiza que la base viaja en un
        único fichero autocontenido.
    -->
    <cloud-backup>
        <exclude domain="sharedpref" path="cotizaciones.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cotizaciones.xml" />
    </device-transfer>
</data-extraction-rules>
